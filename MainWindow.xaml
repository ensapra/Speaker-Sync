<Window x:Class="SpeakerSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speaker Sync" Height="400" Width="600"
        Background="#1E1E1E" Foreground="#E8E8E8">
    <Grid Margin="10" Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center" Background="#1E1E1E">
            <TextBlock VerticalAlignment="Center" Text="Input:" Margin="0,0,8,0" Foreground="#E8E8E8" />
            <ComboBox x:Name="InputCombo" Width="300" Foreground="#E8E8E8" Background="#2D2D2D" SelectionChanged="InputCombo_SelectionChanged" />
            <TextBlock VerticalAlignment="Center" Text="Sample Rate:" Margin="12,0,8,0" Foreground="#E8E8E8" />
            <ComboBox x:Name="SampleRateCombo" Width="120" Foreground="#E8E8E8" Background="#2D2D2D" SelectionChanged="SampleRateCombo_SelectionChanged" />
            <Button x:Name="RefreshBtn" Content="Refresh" Margin="12,0,0,0" Click="RefreshBtn_Click" />
        </StackPanel>

        <GroupBox Header="Outputs" Grid.Row="1" Background="#1E1E1E">
            <ScrollViewer Background="#1E1E1E">
                <StackPanel x:Name="OutputsPanel" Background="#1E1E1E" />
            </ScrollViewer>
        </GroupBox>

        <Grid Grid.Row="2" Margin="0,8,0,0" Background="#1E1E1E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CalibrationStatusText" Text="Ready" VerticalAlignment="Center" Foreground="#E8E8E8" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AutoSyncBtn" Content="Auto Sync" Width="120" Margin="0,0,8,0" Click="AutoSyncBtn_Click" />
                <Button x:Name="StartBtn" Content="Start" Width="100" Margin="0,0,8,0" Click="StartBtn_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
